# Dependencies
node_modules/

# Build artifacts
build/bin/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/dist.bak/
dist/
*.exe
*.dll
*.so
*.dylib
*.syso

# Pacotes gerados no CI (deb/rpm e árvore binária do deb)
pkg/*.deb
pkg/*.rpm
pkg/deb/vidctl/usr/

# Artefatos locais do makepkg (AUR): fonte extraída, root build, tarballs e pacote
pkg/aur/src/
pkg/aur/pkg/
pkg/aur/*.tar.gz
pkg/aur/*.pkg.tar.zst
pkg/aur/*.tar.zst

# Checksum local das dependências do frontend (regravado pelo Wails)
frontend/package.json.md5

# Test / coverage
coverage.out
*.test

# Logs and temp
*.log
*.tmp

# OS cruft
.DS_Store
Thumbs.db

# Editors / IDE
.idea/
.vscode/
*.swp

# Agent skill cache (local, not project)
.agents/
.claude/
agent/
skills-lock.json
# Saída local de ferramenta
execution.out
