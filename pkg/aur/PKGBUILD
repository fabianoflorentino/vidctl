# Maintainer: Fabiano Santos Florentino <fabianoflorentino at gmail dot com>
# Build nativo a partir do fonte (go + npm + wails), encode 2-pass com ffmpeg.
# A cada release: pkg/aur/update-aur.sh <versão> (atualiza pkgver + sha256sums).

pkgname=vidctl
pkgver=2.0.0
pkgrel=1
pkgdesc="Compress video to the exact size of each platform with ffmpeg 2-pass"
arch=('x86_64')
url="https://github.com/fabianoflorentino/vidctl"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'ffmpeg')
makedepends=('go' 'npm')
optdepends=('libnotify: desktop notifications for compression status')
source=("https://github.com/fabianoflorentino/vidctl/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('9e15c9222e5ccf075076bc797835fac7dc74e38decaad42e30fe8ec81c2eaacb')
# Nota: o tarball de tag v${pkgver} do GitHub extrai como vidctl-${pkgver} (sem o v).

prepare() {
  cd "${srcdir}/vidctl-${pkgver}"
  go install github.com/wailsapp/wails/v2/cmd/wails@v2.15.0
}

build() {
  cd "${srcdir}/vidctl-${pkgver}"
  export PATH="$PATH:$(go env GOPATH)/bin"
  wails build -clean -tags webkit2_41
}

package() {
  cd "${srcdir}/vidctl-${pkgver}"
  install -Dm755 build/bin/vidctl "${pkgdir}/usr/bin/vidctl"
  install -Dm644 pkg/vidctl.desktop "${pkgdir}/usr/share/applications/vidctl.desktop"
  install -Dm644 pkg/icon/vidctl-128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/vidctl.png"
  install -Dm644 pkg/icon/vidctl-256.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/vidctl.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/vidctl/LICENSE"
}